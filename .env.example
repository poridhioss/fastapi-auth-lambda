# Local testing only. On Lambda, set these in Configuration > Environment variables.
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TTL_MIN=5
REFRESH_TTL_DAYS=7
AUTHORIZER_CACHE_SIZE=256

# DynamoDB table names + the email GSI name. Defaults match the README.
USERS_TABLE=Users
SESSIONS_TABLE=Sessions
USERS_EMAIL_GSI=email-index

# Region. On Lambda the runtime sets AWS_REGION automatically.
AWS_REGION=ap-southeast-1